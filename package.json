  "scripts": {
    "dev": "vite --host",
    "build": "vite build && esbuild server/index.ts --platform=node --packages=external --bundle --format=esm --outdir=dist",
    "start": "NODE_ENV=production node dist/index.js",
    "preview": "vite preview --host",
    "check": "tsc --noEmit",
    "format": "prettier --write .",
    "bump": "node scripts/bump-version.js",
    "release": "powershell -ExecutionPolicy Bypass -File scripts/release.ps1",
    "release:old": "npm run bump && npm run build && npx cap sync && cd android && .\\gradlew.bat assembleRelease bundleRelease",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "build:apk": "vite build && npx cap sync android && cd android && gradlew assembleDebug",
    "cap:sync": "npx cap sync",
    "build:aab": "vite build && npx cap sync android && cd android && gradlew bundleRelease",
    "build:release": "node scripts/release.mjs"
  },
