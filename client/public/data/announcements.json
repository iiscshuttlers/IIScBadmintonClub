import { useEffect, useState } from "react";

export default function CourtBanner() {
  const [event, setEvent] = useState(null);

  useEffect(() => {
    fetch("/data/events.json")
      .then(res => res.json())
      .then(data => {
        const bookings = data.filter(
          e => e.category === "facility" && e.priority === "high"
        );

        bookings.forEach(event => {
          event.slots?.sort((a, b) => {
            return new Date(`${a.date}T${a.startTime}`) -
                   new Date(`${b.date}T${b.startTime}`);
          });
        });

        setEvent(bookings[0]);
      })
      .catch(err => console.error(err));
  }, []);

  // auto-refresh every minute
  useEffect(() => {
    const interval = setInterval(() => {
      setEvent(prev => (prev ? { ...prev } : prev));
    }, 60000);

    return () => clearInterval(interval);
  }, []);

  if (!event) return null;

  const message = getBannerMessage(event);
  if (!message) return null;

  return (
    <div className="banner whitespace-pre-line">
      {message}
    </div>
  );
}

/* ---------------- LOGIC ---------------- */

function getBannerMessage(event) {
  const now = new Date();

  let todayActive = [];
  let todayUpcoming = [];

  for (const slot of event.slots || []) {
    const start = new Date(`${slot.date}T${slot.startTime}`);
    const end = new Date(`${slot.date}T${slot.endTime}`);
    const label = getDateLabel(slot.date);

    if (label === "today") {
      if (now >= start && now <= end) {
        todayActive.push(slot);
      } else if (now < start) {
        todayUpcoming.push(slot);
      }
    }
  }

  // 🔴 TODAY BOOKINGS
  if (todayActive.length > 0 || todayUpcoming.length > 0) {
    let message = `🚫 ${event.location} booked today\n`;

    if (todayActive.length > 0) {
      const activeRanges = todayActive.map(slot =>
        `${formatTime(slot.startTime)}–${formatTime(slot.endTime)}`
      );
      message += `🔴 Now: ${activeRanges.join(", ")}\n`;
    }

    if (todayUpcoming.length > 0) {
      const upcomingRanges = todayUpcoming.map(slot =>
        `${formatTime(slot.startTime)}–${formatTime(slot.endTime)}`
      );
      message += `⚠️ Later: ${upcomingRanges.join(", ")}`;
    }

    return message.trim();
  }

  // 🟡 FUTURE BOOKINGS
  const futureSlots = (event.slots || []).filter(slot => {
    const start = new Date(`${slot.date}T${slot.startTime}`);
    return now < start;
  });

  if (futureSlots.length > 0) {
    futureSlots.sort((a, b) => {
      return new Date(`${a.date}T${a.startTime}`) -
             new Date(`${b.date}T${b.startTime}`);
    });

    const next = futureSlots[0];
    const label = getDateLabel(next.date);

    const sameDaySlots = futureSlots.filter(s => {
      return getDateLabel(s.date) === label;
    });

    const ranges = sameDaySlots.map(s =>
      `${formatTime(s.startTime)}–${formatTime(s.endTime)}`
    );

    if (label === "tomorrow") {
      return `⚠️ ${event.location} booked tomorrow from ${ranges.join(", ")}`;
    }

    return `⚠️ ${event.location} booked on ${label} from ${ranges.join(", ")}`;
  }

  return null;
}

/* ---------------- HELPERS ---------------- */

function getDateLabel(dateStr) {
  const today = new Date();
  const target = new Date(dateStr);

  today.setHours(0,0,0,0);
  target.setHours(0,0,0,0);

  const diff = (target - today) / (1000 * 60 * 60 * 24);

  if (diff === 0) return "today";
  if (diff === 1) return "tomorrow";

  return target.toLocaleDateString("en-GB");
}

function formatTime(timeStr) {
  const [h, m] = timeStr.split(":");
  const hour = parseInt(h);
  const suffix = hour >= 12 ? "PM" : "AM";
  const formattedHour = hour % 12 || 12;

  return `${formattedHour}:${m} ${suffix}`;
}