import { useEffect, useState } from "react";

export default function CourtBanner() {
  const [event, setEvent] = useState(null);

  useEffect(() => {
    fetch("/data/events.json")
      .then(res => res.json())
      .then(data => {
        // get all high-priority facility events
        const bookings = data.filter(
          e => e.category === "facility" && e.priority === "high"
        );

        // sort by start time (important!)
        bookings.forEach(event => {
          event.slots?.sort((a, b) => {
            return new Date(`${a.date}T${a.startTime}`) -
                   new Date(`${b.date}T${b.startTime}`);
          });
        });

        setEvent(bookings[0]); // for now: first event
      })
      .catch(err => console.error(err));
  }, []);

  if (!event) return null;

  const message = getBannerMessage(event);
  if (!message) return null;

  return (
    <div className="banner">
      {message}
    </div>
  );
}

/* ---------------- LOGIC ---------------- */

function getBannerMessage(event) {
  const now = new Date();

  for (const slot of event.slots || []) {
    const start = new Date(`${slot.date}T${slot.startTime}`);
    const end = new Date(`${slot.date}T${slot.endTime}`);

    const label = getDateLabel(slot.date);

    // 🔴 CURRENTLY CLOSED
    if (now >= start && now <= end) {
      return `🚫 ${event.location} closed today till ${formatTime(slot.endTime)}`;
    }

    // 🟡 UPCOMING
    if (now < start) {
      if (label === "today") {
        return `⚠️ ${event.location} booked today from ${formatTime(slot.startTime)}`;
      }
      if (label === "tomorrow") {
        return `⚠️ ${event.location} booked tomorrow`;
      }
      return `⚠️ ${event.location} booked on ${label}`;
    }
  }

  return null;
}

function getDateLabel(dateStr) {
  const today = new Date();
  const target = new Date(dateStr);

  today.setHours(0,0,0,0);
  target.setHours(0,0,0,0);

  const diff = (target - today) / (1000 * 60 * 60 * 24);

  if (diff === 0) return "today";
  if (diff === 1) return "tomorrow";

  return target.toLocaleDateString("en-GB"); // DD/MM/YYYY
}

function formatTime(timeStr) {
  const [h, m] = timeStr.split(":");
  const hour = parseInt(h);
  const suffix = hour >= 12 ? "PM" : "AM";
  const formattedHour = hour % 12 || 12;

  return `${formattedHour}:${m} ${suffix}`;
}