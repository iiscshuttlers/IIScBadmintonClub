# Create a free account at https://supabase.com
# Create a new project, go to Settings -> API, and copy the Project URL and anon/public key.
# Rename this file to .env.local and paste your keys below.

VITE_SUPABASE_URL=your_project_url_here
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# Firebase Web Push Configuration
VITE_FIREBASE_VAPID_KEY=your_firebase_vapid_key_here
